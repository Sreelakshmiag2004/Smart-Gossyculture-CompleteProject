<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG BUILDS ONLY: this file lives in the debug source set and is not packaged in a release.
     It allows plain HTTP to the LOCAL DEVELOPMENT backend and to nothing else:
       10.0.2.2              the Android emulator's alias for the development machine
       127.0.0.1 / localhost a physical device using "adb reverse tcp:8000 tcp:8000"
     Every other host - and every release build - requires HTTPS (the Android default). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
