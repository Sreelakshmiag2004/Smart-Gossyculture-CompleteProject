# Runtime secrets, generated by Terraform and stored ONLY in AWS Secrets Manager.
#
# The values are EPHEMERAL (never written to the Terraform state or plan) and reach Secrets
# Manager through the write-only argument secret_string_wo. Nobody sees them at generation
# time; the host reads them with bin/render-secrets.sh into tmpfs. Increment var.secret_version
# to rotate everything (then re-render and restart on the host).
#
# Production contains no test OTP code and no test devices. Staging gets both (temporary,
# U-4 / U-7), clearly separated by environment.

locals {
  staging          = var.environment == "staging"
  password_entries = ["db_postgres_password", "db_owner_password", "db_app_password", "mqtt_svc_ingest_password", "mqtt_svc_health_password"]
  key_entries      = ["jwt_signing_key", "otp_hmac_key"]
  test_devices     = local.staging ? toset(var.staging_test_devices) : toset([])
}

ephemeral "random_password" "password" {
  for_each = toset(local.password_entries)
  length   = 40
  special  = false # safe in connection strings and shell
}

ephemeral "random_password" "key" {
  for_each = toset(local.key_entries)
  length   = 64
  special  = false
}

ephemeral "random_password" "test_device" {
  for_each = local.test_devices
  length   = 40
  special  = false
}

ephemeral "random_password" "test_otp_code" {
  count   = local.staging ? 1 : 0
  length  = 6
  upper   = false
  lower   = false
  special = false
  numeric = true
}

resource "aws_secretsmanager_secret" "runtime" {
  name                    = "gossy/${var.environment}/runtime"
  description             = "Smart Gossyculture ${var.environment} runtime secrets (DB, MQTT service accounts, token keys)"
  kms_key_id              = aws_kms_key.main.arn
  recovery_window_in_days = var.environment == "production" ? 30 : 7
}

resource "aws_secretsmanager_secret_version" "runtime" {
  secret_id = aws_secretsmanager_secret.runtime.id
  secret_string_wo = jsonencode(merge(
    { for k in local.password_entries : k => ephemeral.random_password.password[k].result },
    { for k in local.key_entries : k => ephemeral.random_password.key[k].result },
    {
      # null / {} in production (render-secrets.sh refuses non-empty values there)
      test_otp_code     = one(ephemeral.random_password.test_otp_code[*].result)
      mqtt_test_devices = { for d in local.test_devices : d => ephemeral.random_password.test_device[d].result }
    }
  ))
  secret_string_wo_version = var.secret_version
}
