# PRODUCTION - non-secret inputs only. Secrets are generated by Terraform (secrets.tf).
environment           = "production"
instance_type         = "t3.medium"
data_volume_gb        = 50
backup_retention_days = 35 # recommended default; retention policy is U-15 (DPDP review)
log_retention_days    = 30

# DECISION NEEDED (U-6): no domain yet. A production deployment is refused by prodcheck until
# real hostnames and an ACME contact are set here.
api_public_host  = null
mqtt_public_host = null
acme_email       = null
alarm_email      = null

