# STAGING - non-secret inputs only. Secrets are generated by Terraform (secrets.tf).
environment           = "staging"
instance_type         = "t3.medium"
data_volume_gb        = 30
backup_retention_days = 14
log_retention_days    = 14

# DECISION NEEDED (U-6): no domain yet. Leave null; the stack keeps .invalid placeholders.
api_public_host  = null
mqtt_public_host = null
acme_email       = null
alarm_email      = null

# Temporary simulator devices for infrastructure testing (U-7 open). Staging only.
staging_test_devices = ["sim-0001", "sim-0002"]

