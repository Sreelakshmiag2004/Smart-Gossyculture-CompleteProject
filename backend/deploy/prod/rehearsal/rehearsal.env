# LOCAL REHEARSAL ONLY - /etc/gossy/gossy.env of the rehearsal host. No AWS, no real domain.
GOSSY_ENVIRONMENT=staging
GOSSY_AWS_REGION=ap-south-1
GOSSY_IMAGE_REPO=gossy-backend
GOSSY_LOG_GROUP=/gossy/rehearsal/app
GOSSY_SECRET_ID=unused-in-rehearsal
GOSSY_API_PUBLIC_HOST=api.rehearsal.invalid
GOSSY_MQTT_PUBLIC_HOST=mqtt.rehearsal.invalid
GOSSY_ACME_EMAIL=
GOSSY_TLS_PROFILE=internal
GOSSY_AUTH_TEST_MODE=true
GOSSY_AUTH_TEST_PHONE_NUMBERS=+99900000001,+99900000002,+99900000003,+99900000009
GOSSY_AUTH_TEST_OTP_CODE_FILE=/run/gossy-secrets/auth/test-otp.code
# Staging test runs only: relaxed abuse limits (the first rehearsal test run with production
# limits returned 429 for repeated sign-ins - the limiter works) and short WebSocket intervals.
GOSSY_AUTH_OTP_REQUESTS_PER_PHONE=500
GOSSY_AUTH_OTP_REQUESTS_PER_IP=2000
GOSSY_AUTH_OTP_VERIFICATIONS_PER_IP=2000
GOSSY_API_CLAIM_ATTEMPTS_PER_USER=2000
GOSSY_API_WS_HEARTBEAT_S=3
GOSSY_API_WS_REFRESH_S=3
# Shortened from 300 s so the prolonged-blockage alert can be observed in the rehearsal.
GOSSY_INGEST_RETRY_PROLONGED_AFTER_S=30
GOSSY_REGISTRY_LOGIN=none
GOSSY_SECRETS_FILE=/etc/gossy/rehearsal-secrets.json
GOSSY_COMPOSE_EXTRA="-f /opt/gossy/rehearsal/compose.rehearsal.yaml"
GOSSY_BACKUP_DEST=local:/srv/offhost-backups
GOSSY_CERT_WAIT_S=120
