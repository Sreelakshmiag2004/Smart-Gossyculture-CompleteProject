[Unit]
Description=Render Smart Gossyculture secrets from AWS Secrets Manager into tmpfs
After=network-online.target
Wants=network-online.target
# Ordered before Docker: after a host reboot the secrets tmpfs is mounted and filled before the
# daemon restarts the containers that bind-mount it (ordering only - Docker still starts if
# this unit fails, and containers then restart until gossy.service has rendered the secrets).
Before=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/gossy/bin/render-secrets.sh
StandardOutput=append:/var/log/gossy/ops.log
StandardError=append:/var/log/gossy/ops.log
ExecStop=/bin/sh -c 'umount /run/gossy-secrets || true'

[Install]
WantedBy=multi-user.target
