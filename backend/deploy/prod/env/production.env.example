# /etc/gossy/gossy.env - PRODUCTION. Maintained by Terraform in the SSM parameter
# /gossy/production/host-env (deploy/aws/terraform/compute.tf); bin/render-config.sh copies it
# to the host at every deployment. This file documents the shape only - do not edit on the host.
# NON-SECRET settings only. Secrets live in AWS Secrets Manager (GOSSY_SECRET_ID).
GOSSY_ENVIRONMENT=production
GOSSY_AWS_REGION=ap-south-1
GOSSY_CONFIG_PARAMETER=/gossy/production/host-env
GOSSY_IMAGE_REPO=<account-id>.dkr.ecr.ap-south-1.amazonaws.com/gossy/production/backend
GOSSY_LOG_GROUP=/gossy/production/app
GOSSY_SECRET_ID=gossy/production/runtime
GOSSY_BACKUP_BUCKET=<backup bucket from terraform output>
GOSSY_KMS_KEY_ARN=<kms key arn from terraform output>
# DECISION NEEDED (U-6): no domain exists yet. Deployment is refused (prodcheck) until set.
GOSSY_API_PUBLIC_HOST=<api host, e.g. api.<your-domain>>
GOSSY_MQTT_PUBLIC_HOST=<mqtt host, e.g. mqtt.<your-domain>>
GOSSY_ACME_EMAIL=<operations mailbox for Let's Encrypt expiry notices>
GOSSY_TLS_PROFILE=acme
GOSSY_AUTH_TEST_MODE=false
GOSSY_INGEST_RETRY_PROLONGED_AFTER_S=300
