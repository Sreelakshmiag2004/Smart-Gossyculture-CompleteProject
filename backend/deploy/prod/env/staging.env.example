# /etc/gossy/gossy.env - STAGING. Maintained by Terraform in the SSM parameter
# /gossy/staging/host-env (deploy/aws/terraform/compute.tf); bin/render-config.sh copies it to
# the host at every deployment. This file documents the shape only - do not edit on the host.
# NON-SECRET settings only. Secrets live in AWS Secrets Manager (GOSSY_SECRET_ID).
GOSSY_ENVIRONMENT=staging
GOSSY_AWS_REGION=ap-south-1
GOSSY_CONFIG_PARAMETER=/gossy/staging/host-env
GOSSY_IMAGE_REPO=<account-id>.dkr.ecr.ap-south-1.amazonaws.com/gossy/staging/backend
GOSSY_LOG_GROUP=/gossy/staging/app
GOSSY_SECRET_ID=gossy/staging/runtime
GOSSY_BACKUP_BUCKET=<backup bucket from terraform output>
GOSSY_KMS_KEY_ARN=<kms key arn from terraform output>
GOSSY_API_PUBLIC_HOST=<staging api host (U-6)>
GOSSY_MQTT_PUBLIC_HOST=<staging mqtt host (U-6)>
GOSSY_ACME_EMAIL=<operations mailbox>
GOSSY_TLS_PROFILE=acme
# Staging only: allow-listed +999 test numbers with the fixed code from the secret. No SMS.
GOSSY_AUTH_TEST_MODE=true
GOSSY_AUTH_TEST_PHONE_NUMBERS=+99900000001,+99900000002,+99900000009
GOSSY_AUTH_TEST_OTP_CODE_FILE=/run/gossy-secrets/auth/test-otp.code
GOSSY_INGEST_RETRY_PROLONGED_AFTER_S=300
