# Reference of the environment variables the backend reads. CONTAINS NO CREDENTIALS.
# The dev Compose stack (deploy/dev/compose.yaml) already sets these; this file documents
# them for running a service outside Compose. Secrets are always supplied as *_FILE paths
# generated by the bootstrap service - never paste a password into an env file.

# --- common ---
# Required. One of: development | test | staging | production
GOSSY_ENVIRONMENT=development
GOSSY_LOG_LEVEL=INFO
GOSSY_LOG_JSON=true

# --- database (api, ingest, migrate) ---
GOSSY_DB_HOST=timescaledb
GOSSY_DB_PORT=5432
GOSSY_DB_NAME=gossy
# Runtime role. Migrations use gossy_owner with /run/gossy-secrets/db/owner.password
GOSSY_DB_USER=gossy_app
GOSSY_DB_PASSWORD_FILE=/run/gossy-secrets/db/app.password

# --- api ---
# Refused (startup error) in staging/production.
GOSSY_API_DOCS_ENABLED=true

GOSSY_API_CLAIM_CODE_TTL_S=604800
GOSSY_API_CLAIM_ATTEMPTS_PER_USER=10
GOSSY_API_WS_HEARTBEAT_S=25
GOSSY_API_WS_REFRESH_S=30
GOSSY_API_WS_QUEUE_SIZE=1000
GOSSY_API_WS_REPLAY_LIMIT=1000
# Telemetry freshness (docs/mqtt-contract.md): reporting interval and "no longer current" threshold
GOSSY_API_TELEMETRY_INTERVAL_S=60
GOSSY_API_TELEMETRY_STALE_AFTER_S=180

# --- auth (api) - key files are generated by the bootstrap service ---
GOSSY_AUTH_JWT_SIGNING_KEY_FILE=/run/gossy-secrets/auth/jwt-signing.key
GOSSY_AUTH_OTP_HMAC_KEY_FILE=/run/gossy-secrets/auth/otp-hmac.key
GOSSY_AUTH_ACCESS_TOKEN_TTL_S=900
GOSSY_AUTH_REFRESH_TOKEN_TTL_S=2592000
GOSSY_AUTH_OTP_TTL_S=300
GOSSY_AUTH_OTP_MAX_ATTEMPTS=5
# OTP TEST MODE: the only OTP mechanism implemented. No SMS is sent. Refused in production.
# Numbers must be in the unassigned +999 range. Real SMS delivery is undecided (U-4).
GOSSY_AUTH_TEST_MODE=true
GOSSY_AUTH_TEST_PHONE_NUMBERS=+99900000001,+99900000002
GOSSY_AUTH_TEST_OTP_CODE_FILE=/run/gossy-secrets/auth/test-otp.code

# --- mqtt (ingest) - TLS only, no plaintext option ---
GOSSY_MQTT_HOST=mosquitto
GOSSY_MQTT_PORT=8883
GOSSY_MQTT_CLIENT_ID=svc-ingest-1
GOSSY_MQTT_USERNAME=svc-ingest
GOSSY_MQTT_PASSWORD_FILE=/run/gossy-secrets/mqtt/svc-ingest.password
GOSSY_MQTT_CA_FILE=/run/gossy-secrets/certs/ca.crt

# --- ingest limits ---
GOSSY_INGEST_MAX_PAYLOAD_BYTES=65536
GOSSY_INGEST_MAX_FUTURE_SKEW_S=300
# Transient DB errors are retried without limit (message stays unacknowledged at the broker);
# only non-transient errors count towards STORE_RETRY_ATTEMPTS before dead-lettering.
GOSSY_INGEST_STORE_RETRY_ATTEMPTS=5
GOSSY_INGEST_STORE_RETRY_BACKOFF_S=0.5
GOSSY_INGEST_STORE_RETRY_MAX_BACKOFF_S=30
# Development/test ONLY - failure injection for the durability tests. Refused in staging/prod.
# GOSSY_INGEST_FAULT_INJECTION_DIR=/run/gossy-faults

# --- simulator (development only; device IDs must start with sim-) ---
GOSSY_SIM_DEVICE_ID=sim-0001
GOSSY_SIM_HOST=mosquitto
GOSSY_SIM_PORT=8883
GOSSY_SIM_CA_FILE=/run/gossy-secrets/certs/ca.crt
GOSSY_SIM_PASSWORD_FILE=/run/gossy-secrets/mqtt/sim-0001.password
